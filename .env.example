# ===== Aplicação =====
APP_NAME=Protheus Reports — Fertimaxi
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Timezone usado em backend e frontend. NÃO mude sem motivo.
APP_TIMEZONE=America/Sao_Paulo

# ===== Segurança =====
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-esta-chave-em-producao-com-um-token-aleatorio-de-64-bytes
JWT_ALGORITHM=HS256
# Tempo de vida do token (minutos). 480 = 8h.
JWT_EXPIRE_MINUTES=480
# Tempo máximo OCIOSO antes do auto-logout (minutos). O frontend monitora
# mouse/teclado e desloga após esse intervalo sem atividade.
SESSION_IDLE_MINUTES=20

# ===== Banco LOCAL da aplicação (usuários, auditoria, agendamentos) =====
# SQLite (dev): sqlite:///./data/app.db
# SQL Server : mssql+pyodbc://user:pass@host:1433/dbname?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=sqlite:///./data/app.db

# ===== Protheus — Conexão DIRETA ao SQL Server =====
# Formato: mssql+pyodbc://USUARIO:SENHA@HOST:PORTA/BANCO?driver=DRIVER&TrustServerCertificate=yes
#
# IMPORTANTE — URL-encoding na senha:
#   ?  ->  %3F     #  ->  %23     /  ->  %2F     espaço -> %20 ou +
#   @  ->  %40     :  ->  %3A     &  ->  %26
#
# Driver: o nome precisa bater EXATAMENTE com um item de `pyodbc.drivers()`.
# Verifique em http://localhost:8000/api/protheus/drivers (logado como admin)
# ou no terminal: `python -c "import pyodbc; print(pyodbc.drivers())"`
PROTHEUS_DB_URL=mssql+pyodbc://USUARIO:SENHA@HOST:PORTA/BANCO?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Sufixo do nome físico das tabelas Protheus (Alias + Filial + sufixo).
# Padrão Fertimaxi: '0' (ex.: SE1 + 01 + 0 -> SE1010).
PROTHEUS_TABLE_SUFFIX=0

# ===== SMTP (envio de e-mails) =====
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario@empresa.com.br
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM=seu-usuario@empresa.com.br
SMTP_USE_TLS=true

# ===== Admin inicial (criado pelo seed) =====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_PASSWORD=defina-uma-senha-forte

# ===== Scheduler =====
SCHEDULER_INTERVAL_MINUTES=60
REPORTS_OUTPUT_DIR=./reports_output
